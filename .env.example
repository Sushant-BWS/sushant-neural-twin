APP_NAME=Sushant Neural Twin
APP_VERSION=0.1.0
APP_ENV=development
DEBUG=true
API_PREFIX=/api
HOST=127.0.0.1
PORT=8000
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
AUTH_ENABLED=false
# Set AUTH_TOKEN through a secret manager or local .env; never commit a real token.
AUTH_TOKEN=
RATE_LIMIT_REQUESTS=60
RATE_LIMIT_WINDOW_SECONDS=60
